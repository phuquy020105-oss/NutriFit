# Copy this file to .env and replace placeholders locally. Never commit .env.
SECRET_KEY=
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=NutriFitDB

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TIMEOUT=20
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

GEMINI_API_KEY=
GEMINI_MODEL=

# Configure only with a real account before accepting payments.
NUTRIFIT_BANK_BIN=
NUTRIFIT_BANK_ACCOUNT_NO=
NUTRIFIT_BANK_ACCOUNT_NAME=
# Required for authenticated payment webhooks. Generate a long random secret.
PAYMENT_WEBHOOK_SECRET=

# Default registration keeps normal email behavior. Enable only on local Demo after review.
NUTRIFIT_ENV=production
NUTRIFIT_DEMO_REGISTRATION=false
MAIL_SUPPRESS_SEND=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
NUTRITION_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Gmail OTP registration always enforced; demo mode never bypasses OTP.
# One-time DB migration: python setup/install_registration_otp.py
# Register -> email OTP (6 digits, 10 minutes) -> verified account created.
