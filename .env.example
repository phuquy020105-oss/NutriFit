# scripts/run-local.ps1 loads .env for local setup/run. Java/Tomcat alone does not.
# Set these variables in the IDE/Tomcat process or Render Dashboard; never commit .env.
PORT=8080

# Blank URL retains the existing local JDBC URL. On Render, set BOTH URL and CA path.
# Cloud URL example: jdbc:mysql://<AIVEN_HOST>:27047/nutrifitdb?sslMode=VERIFY_IDENTITY&useUnicode=true&characterEncoding=UTF-8
NUTRIFIT_DB_URL=
# Render Secret File: /etc/secrets/ca.pem. Leave blank for ordinary local development.
NUTRIFIT_DB_CA_FILE=
NUTRIFIT_DB_USER=
NUTRIFIT_DB_PASSWORD=

BREVO_API_KEY=
# Use an address verified in Brevo, not a placeholder sender.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NutriFit
NUTRIFIT_IP_HASH_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# After Render assigns a domain: https://<RENDER_DOMAIN>/nutrifit/payment/return
VNPAY_RETURN_URL=

# Opt-in request timing logs; includes only normalized routes, status and aggregate timings.
NUTRIFIT_PERF_ENABLED=false
# Optional isolated loopback test target; leave blank on Render and ordinary local runs.
# Accepts only nutrifit_*_test, and cannot be combined with NUTRIFIT_DB_URL.
NUTRIFIT_LOCAL_DB_NAME=
