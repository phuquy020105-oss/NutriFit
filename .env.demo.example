# Local Demo template only; Flask reads ROOT .env, not this file.
# Copy only if .env does not already exist. Fill secrets locally, never in chat/Git.
# SECRET_KEY must be private, nonempty and stable across local restarts.
SECRET_KEY=
# Disabled by default. LOCAL ONLY: set development + true after reviewing the change.
NUTRIFIT_ENV=production
NUTRIFIT_DEMO_REGISTRATION=false
# Optional suppression is recognized only in development; demo skips mail entirely.
MAIL_SUPPRESS_SEND=false
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=NutriFitDB
# DATABASE_URL is intentionally omitted; an inherited value takes precedence.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
NUTRITION_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Blank key disables real Gemini calls; Meal Planner uses its existing fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
# Local-only, unconfigured SMTP; guarded Demo registration skips mail.send entirely.
# Do not register accounts or run payment/email flows in this preparation step.
MAIL_SERVER=127.0.0.1
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
NUTRIFIT_BANK_BIN=
NUTRIFIT_BANK_ACCOUNT_NO=
NUTRIFIT_BANK_ACCOUNT_NAME=
PAYMENT_WEBHOOK_SECRET=
