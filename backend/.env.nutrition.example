# Merge these MODULE settings into backend/.env or root .env; never commit real secrets.
# Keep DATABASE_URL and SMTP configuration owned by core.
# Use a locally generated stable random SECRET_KEY for sessions across restarts.
SECRET_KEY=
NUTRITION_FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
NUTRIFIT_TIMEZONE=Asia/Ho_Chi_Minh
# Leave key/model empty to use local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=1
GEMINI_COOLDOWN_SECONDS=30
