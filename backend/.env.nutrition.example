# Copy the needed entries to the project's .env; never commit real credentials.
SECRET_KEY=
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=NutriFitDB
# Optional DATABASE_URL overrides DB_* (keep it private).
DATABASE_URL=
ACCESS_TOKEN_MAX_AGE=3600
NUTRIFIT_TIMEZONE=Asia/Ho_Chi_Minh
# Leave both empty to use the seven-day fallback without external requests.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=1
GEMINI_COOLDOWN_SECONDS=30
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
